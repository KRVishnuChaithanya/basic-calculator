import tkinter as tk
from tkinter import messagebox
import math
import numpy as np
# ------------------- Global Memory -------------------
memory = 0

# ------------------- Functions -------------------
def evaluate_expression(event=None):
    try:
        expression = entry.get()
        result = eval(expression, {"__builtins__": None}, math.__dict__)
        entry.delete(0, tk.END)
        entry.insert(tk.END, str(result))
        add_to_history(f"{expression} = {result}")
    except ZeroDivisionError:
        messagebox.showerror("Math Error", "Division by zero is not allowed.")
    except Exception:
        messagebox.showerror("Error", "Invalid Expression")

def insert_text(text):
    entry.insert(tk.END, text)

def clear_entry(event=None):
    entry.delete(0, tk.END)

def backspace(event=None):
    current = entry.get()
    entry.delete(0, tk.END)
    entry.insert(0, current[:-1])

def add_to_history(calc):
    history_list.insert(tk.END, calc)

def clear_history():
    history_list.delete(0, tk.END)

# ------------------- Memory Operations -------------------
def memory_add():
    global memory
    try:
        memory += float(entry.get())
        entry.delete(0, tk.END)
    except:
        messagebox.showerror("Error", "Invalid input for memory")

def memory_subtract():
    global memory
    try:
        memory -= float(entry.get())
        entry.delete(0, tk.END)
    except:
        messagebox.showerror("Error", "Invalid input for memory")

def memory_recall():
    entry.insert(tk.END, str(memory))

def memory_clear():
    global memory
    memory = 0

# ------------------- Theme -------------------
def toggle_theme():
    current_bg = root.cget("bg")
    if current_bg == "#1e1e1e":
        root.config(bg="white")
        entry.config(bg="white", fg="black", insertbackground="black")
        history_list.config(bg="white", fg="black")
    else:
        root.config(bg="#1e1e1e")
        entry.config(bg="#2d2d2d", fg="white", insertbackground="white")
        history_list.config(bg="#2d2d2d", fg="white")

# ------------------- Keyboard Input -------------------
def key_input(event):
    key = event.keysym
    if key in "0123456789":
        insert_text(key)
    elif key in ["plus", "KP_Add"]:
        insert_text("+")
    elif key in ["minus", "KP_Subtract"]:
        insert_text("-")
    elif key in ["asterisk", "KP_Multiply"]:
        insert_text("*")
    elif key in ["slash", "KP_Divide"]:
        insert_text("/")
    elif key == "period":
        insert_text(".")
    elif key == "parenleft":
        insert_text("(")
    elif key == "parenright":
        insert_text(")")
    elif key in ["Return", "KP_Enter"]:
        evaluate_expression()
    elif key == "BackSpace":
        backspace()
    elif key == "Delete":
        clear_entry()

# ------------------- GUI Setup -------------------
root = tk.Tk()
root.title("Advanced Python Calculator")
root.geometry("900x550")
root.config(bg="#1e1e1e")
root.resizable(False, False)

# Entry
entry = tk.Entry(root, font=("Arial", 20), bd=10, relief=tk.RIDGE,
                 justify="right", bg="#2d2d2d", fg="white", insertbackground="white")
entry.grid(row=0, column=0, columnspan=9, pady=10, padx=10, ipady=10)

# Buttons
buttons = [
    ("7", 1, 0), ("8", 1, 1), ("9", 1, 2), ("/", 1, 3), ("C", 1, 4), ("⌫", 1, 5), 
    ("History", 1, 6), ("ClearHist", 1, 7), ("^", 1, 8),
    ("4", 2, 0), ("5", 2, 1), ("6", 2, 2), ("*", 2, 3), ("(", 2, 4), (")", 2, 5), 
    ("%", 2, 6), ("mod", 2, 7), ("pi", 2, 8),
    ("1", 3, 0), ("2", 3, 1), ("3", 3, 2), ("-", 3, 3), ("!", 3, 4), 
    ("e", 3, 5), ("Theme", 3, 6), ("+", 3, 7), ("=", 3, 8),
    ("0", 4, 0), (".", 4, 1), ("sqrt", 4, 2), ("pow", 4, 3), ("log", 4, 4), 
    ("exp", 4, 5), ("abs", 4, 6), ("sin", 4, 7), ("cos", 4, 8),
    ("tan", 5, 0), ("M+", 5, 1), ("M-", 5, 2), ("MR", 5, 3), ("MC", 5, 4)
]

# Button actions
for (text, row, col) in buttons:
    if text == "=":
        action = evaluate_expression
    elif text == "C":
        action = clear_entry
    elif text == "⌫":
        action = backspace
    elif text == "pi":
        action = lambda t=math.pi: insert_text(str(t))
    elif text == "e":
        action = lambda t=math.e: insert_text(str(t))
    elif text == "%":
        action = lambda: insert_text("/100")
    elif text == "!":
        action = lambda: insert_text("math.factorial(")
    elif text == "mod":
        action = lambda: insert_text("%")
    elif text == "^":
        action = lambda: insert_text("**")
    elif text == "Theme":
        action = toggle_theme
    elif text == "History":
        action = lambda: add_to_history(entry.get())
    elif text == "ClearHist":
        action = clear_history
    else:
        action = lambda t=text: insert_text(t)

    tk.Button(root, text=text, width=7, height=2, font=("Arial", 12, "bold"),
              command=action, bg="#333", fg="white", activebackground="#555").grid(row=row, column=col, padx=5, pady=5)

# History box
history_list = tk.Listbox(root, height=12, width=45, bg="#2d2d2d", fg="white", font=("Arial", 10))
history_list.grid(row=1, column=9, rowspan=6, padx=10, pady=5)

# Keyboard binding
root.bind("<Key>", key_input)

# ------------------- Run -------------------
root.mainloop()
